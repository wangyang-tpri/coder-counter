{
  "name": "coder-counter",
  "publisher": "wang-yang",
  "displayName": "Coder Counter",
  "description": "统计选中文件/文件夹代码行数，变更历史、图表可视化，编辑器行尾Git变更提示，将选中文件夹中的所有代码导出为Word文档",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyang-tpri/coder-counter.git"
  },
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:code-counter.countCode",
    "onCommand:code-counter.exportWord",
    "onCommand:code-counter.openChart",
    "onCommand:code-counter.openFileCommitHistory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "command": "code-counter.countCode",
          "group": "navigation",
          "when": "resourceScheme == file"
        },
        {
          "command": "code-counter.exportWord",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "code-counter.openChart",
          "title": "CodeCounter: 打开统计可视化图表"
        },
        {
          "command": "code-counter.openFileCommitHistory",
          "title": "CodeCounter: 查看文件提交历史"
        }
      ]
    },
    "commands": [
      {
        "command": "code-counter.countCode",
        "title": "统计代码行数"
      },
      {
        "command": "code-counter.exportWord",
        "title": "导出代码为Word文档"
      },
      {
        "command": "code-counter.openChart",
        "title": "打开统计可视化图表"
      },
      {
        "command": "code-counter.openFileCommitHistory",
        "title": "查看文件提交历史"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:first": "standard-version --first-release",
    "prepare": "husky",
    "commit": "npx czg"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "cz-git": "^1.14.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,vue,jsx,tsx}": [
      "eslint --fix"
    ]
  }
}
