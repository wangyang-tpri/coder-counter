{
  "name": "coder-counter",
  "publisher": "wang-yang",
  "displayName": "Coder Counter",
  "description": "统计选中文件/文件夹代码行数，变更历史、图表可视化，编辑器行尾Git变更提示",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyang-tpri/coder-counter.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:code-counter.countCode",
    "onCommand:code-counter.exportWord",
    "onCommand:code-counter.openChart",
    "onCommand:code-counter.openFileCommitHistory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "command": "code-counter.countCode",
          "group": "navigation",
          "when": "resourceScheme == file"
        },
        {
          "command": "code-counter.exportWord",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "code-counter.openChart",
          "title": "CodeCounter: 打开统计可视化图表"
        },
        {
          "command": "code-counter.openFileCommitHistory",
          "title": "CodeCounter: 查看文件提交历史"
        }
      ]
    },
    "commands": [
      {
        "command": "code-counter.countCode",
        "title": "统计代码行数"
      },
      {
        "command": "code-counter.exportWord",
        "title": "导出代码为Word文档"
      },
      {
        "command": "code-counter.openChart",
        "title": "打开统计可视化图表"
      },
      {
        "command": "code-counter.openFileCommitHistory",
        "title": "查看文件提交历史"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  }
}
